# Managed Postgres (Neon, Supabase, or local). Free tier is ample at this volume.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Meta Graph API version used for Conversions API calls.
# v26.0 was current as of September 2026. Versions expire ~2 years after the next
# release, so bump this a couple of times a year.
META_API_VERSION=v26.0

# One CAPI system-user token per project. The database stores only the NAME of the
# env var (tracking.capi_token_ref), never the secret itself.
# META_CAPI_TOKEN_<SLUG_UPPERCASED_WITH_UNDERSCORES>
META_CAPI_TOKEN_ALIAS_ONE=

# Optional: while testing, paste the Test Event Code from Events Manager to see
# events land in the Test Events tab without polluting real data.
# META_TEST_EVENT_CODE_ALIAS_ONE=

# --- Admin ---------------------------------------------------------------
# Host the admin is served from. Must NOT be one of your project domains, so the admin
# is never served from a page you run ads to. Unset means the admin is available only in
# development — a production deploy that forgets this has no admin, rather than an open one.
ADMIN_HOST=admin.yourhouse.com

# Generate with: npm run admin:hash -- yourpassword
ADMIN_PASSWORD_HASH=

# Signs the admin session cookie. Any long random string; changing it signs everyone out.
SESSION_SECRET=
